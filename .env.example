# Postgres connection string (Neon in production; any Postgres 14+ locally)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Secret used to sign admin JWTs (min 32 chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Bearer secret for the daily demo-reset cron (GET /api/cron/reset-demo). Vercel Cron sends it automatically.
CRON_SECRET=change-me-to-another-long-random-string
